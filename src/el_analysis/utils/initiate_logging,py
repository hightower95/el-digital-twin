from ..config import config
import sys

from loguru import logger

def setup_logger(log_file=config.LoggingConfiguration.Filename):
    logger.remove()  # Remove default handler

    # One log file, multiple filters per module
    logger.add(
        log_file,
        level=config.LoggingConfiguration.DefaultLevel,
        format=config.LoggingConfiguration.Format,
        enqueue=True,
        mode="w",
        filter={
            "address": config.FileLoggingLevels.Address,    
            # "address": "DEBUG",  # Set to DEBUG for address module
        }
    )

    logger.info("Logger setup complete with file: {}", log_file)

    return logger

setup_logger()


